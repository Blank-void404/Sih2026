# ============================================================
# Jharkhand Societal Innovation Portal — Environment Variables
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production (Vercel), set these in:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
# NEVER commit .env.local or .env to version control.
# ============================================================

# Supabase Project URL
# Found at: https://supabase.com/dashboard → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (public) Key
# Found at: https://supabase.com/dashboard → Your Project → Settings → API
# This is safe to expose in the browser (it's a public key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
